# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connection (Neon Serverless PostgreSQL or local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/stormsale?schema=public"

# Redis Cache & Queues (Optional for local testing, recommended for production)
REDIS_URL="redis://localhost:6379"

# Stellar Network & RPC Configuration
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STORMSALE_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Security & CORS
JWT_SECRET="replace-with-a-cryptographically-secure-random-32-char-secret"
CORS_ORIGIN="http://localhost:3000,https://stormsale.io"
